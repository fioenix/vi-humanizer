# Release archives generated by scripts/package-skill.sh
/dist/

# Local evaluation runs and scratch deliverables
/artifacts/
/output/
/research/

# Generated maintainer agent tooling and local integration state
/.agents/skills/
/.superpowers/
/.specify/init-options.json
/.specify/integration.json
/.specify/integrations/codex.manifest.json
/.claude/settings.local.json

# Environment variables; sanitized examples may be committed
.env
.env.*
!.env.example
!.env.*.example

# Python environments, caches and coverage output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
/htmlcov/
/coverage.xml

# Operating-system files
.DS_Store
Thumbs.db

# .specify/.gitignore owns feature.json and extension local-config.yml rules.
